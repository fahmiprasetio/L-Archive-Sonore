# ==========================================================
# L'Archive Sonore — contoh environment variables
# Salin file ini menjadi .env.local lalu isi nilainya.
# ==========================================================

# --- Supabase (auth front-end + database) ---
NEXT_PUBLIC_SUPABASE_URL=https://hfnuvshivigrfttvmvfm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Supabase service-role (SERVER ONLY — JANGAN diawali NEXT_PUBLIC) ---
# Dipakai untuk: mencatat order, webhook pembayaran, CRUD produk admin,
# dan membaca semua order di dashboard admin. Bypass RLS — rahasiakan!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Admin allowlist (email dipisah koma) ---
NEXT_PUBLIC_ADMIN_EMAILS=nfahmi086@gmail.com

# --- Midtrans (Sandbox) ---
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id
MIDTRANS_SERVER_KEY=your_midtrans_server_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
# Set Payment Notification URL di dashboard Midtrans ke:
#   https://<domain-anda>/api/payment/notification

# --- Upstash Redis (rate limiting terdistribusi — SERVER ONLY) ---
# Wajib untuk produksi di Vercel agar rate limit konsisten lintas instance.
# Buat database gratis di https://console.upstash.com lalu salin kredensial REST.
# Bila dikosongkan, app otomatis fallback ke rate limiter in-memory (cukup dev lokal).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Postgres (untuk Prisma / migrasi, server-only) ---
DATABASE_URL=
DIRECT_URL=

# --- Sentry (error monitoring) ---
# DSN dari Sentry -> Project Settings -> Client Keys (DSN). Aman untuk publik.
# Event hanya dikirim saat NODE_ENV=production DAN DSN terisi.
NEXT_PUBLIC_SENTRY_DSN=
# Opsional: atur sampling trace (default 0.1 = 10%).
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Opsional: Session Replay (default 0 = nonaktif).
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
# --- Sentry source map upload (CI/Vercel only — RAHASIA) ---
# Diperlukan agar stack trace ter-unminify. Build tetap jalan walau kosong.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
