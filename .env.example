# ==========================================================
# L'Archive Sonore — contoh environment variables
# Salin file ini menjadi .env.local lalu isi nilainya.
# ==========================================================

# --- Supabase (auth front-end + database) ---
NEXT_PUBLIC_SUPABASE_URL=https://hfnuvshivigrfttvmvfm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Supabase service-role (SERVER ONLY — JANGAN diawali NEXT_PUBLIC) ---
# Dipakai untuk: mencatat order, webhook pembayaran, CRUD produk admin,
# validasi kupon, pelacakan pesanan guest, dan membaca semua order di dashboard admin.
# Bypass RLS — rahasiakan!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Admin allowlist (email dipisah koma) ---
NEXT_PUBLIC_ADMIN_EMAILS=nfahmi086@gmail.com

# --- Midtrans ---
# Kunci Sandbox berawalan 'SB-' (mis. SB-Mid-server-xxx). Kunci Production TANPA 'SB-'.
# Pastikan pasangan kunci COCOK dengan mode di bawah.
MIDTRANS_MERCHANT_ID=your_midtrans_merchant_id
MIDTRANS_SERVER_KEY=your_midtrans_server_key
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=your_midtrans_client_key
# Mode Midtrans: 'false' = Sandbox (dev), 'true' = Production (live).
# Set KEDUANYA dengan nilai sama. NEXT_PUBLIC_* dipakai klien untuk memilih
# Snap script (sandbox vs production); yang tanpa prefix dipakai server.
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# Notification URL (webhook) — OPSIONAL.
# Dikirim per-transaksi via header X-Override-Notification, sehingga SATU akun
# Midtrans bisa dipakai banyak website tanpa mengubah setelan dashboard.
# Bila dikosongkan, URL dideteksi OTOMATIS dari domain request
#   -> https://<domain>/api/payment/notification
# Isi hanya bila ingin memaksa URL tertentu (mis. saat pakai custom domain/proxy).
MIDTRANS_NOTIFICATION_URL=

# --- Cloudflare Turnstile (CAPTCHA anti-bot, OPSIONAL & GRATIS) ---
# Melindungi checkout (server-verified) serta form sign in/up (gate klien) dari
# bot & spam. Bila DIKOSONGKAN, captcha NONAKTIF otomatis dan semua form tetap
# berfungsi normal (env-driven, tanpa ubah kode).
# Buat site key + secret key gratis di https://dash.cloudflare.com -> Turnstile.
# Site key bersifat PUBLIK (dipakai widget di browser).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key RAHASIA (server-only) — dipakai memverifikasi token di /api/payment.
TURNSTILE_SECRET_KEY=

# --- AI Shopping Assistant (opsional, GRATIS) ---
# Bila dikosongkan, chat memakai fallback lokal (pencarian katalog) — tetap jalan.
# Provider OpenAI-compatible. Default Groq (gratis, cepat): https://console.groq.com/keys
# Alternatif gratis lain: OpenRouter (https://openrouter.ai) atau Google Gemini
# via endpoint OpenAI-compatible-nya.
AI_CHAT_API_KEY=
# Base URL provider (tanpa trailing slash). Default Groq bila dikosongkan.
AI_CHAT_BASE_URL=https://api.groq.com/openai/v1
# Model. Default llama-3.3-70b-versatile (Groq).
AI_CHAT_MODEL=llama-3.3-70b-versatile

# --- Upstash Redis (rate limiting terdistribusi — SERVER ONLY) ---
# Wajib untuk produksi di Vercel agar rate limit konsisten lintas instance.
# Buat database gratis di https://console.upstash.com lalu salin kredensial REST.
# Bila dikosongkan, app otomatis fallback ke rate limiter in-memory (cukup dev lokal).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Situs (untuk metadata, sitemap, canonical, fallback webhook URL) ---
NEXT_PUBLIC_SITE_URL=https://l-archive-sonore.vercel.app

# --- Postgres (untuk Prisma / migrasi, server-only) ---
DATABASE_URL=
DIRECT_URL=

# --- Sentry (error monitoring) ---
# DSN dari Sentry -> Project Settings -> Client Keys (DSN). Aman untuk publik.
# Event hanya dikirim saat NODE_ENV=production DAN DSN terisi.
NEXT_PUBLIC_SENTRY_DSN=
# Opsional: atur sampling trace (default 0.1 = 10%).
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_TRACES_SAMPLE_RATE=0.1
# Opsional: Session Replay (default 0 = nonaktif).
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0
# --- Sentry source map upload (CI/Vercel only — RAHASIA) ---
# Diperlukan agar stack trace ter-unminify. Build tetap jalan walau kosong.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
